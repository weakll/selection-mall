MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_DATABASE=selection_mall
MYSQL_USERNAME=selection_mall
MYSQL_PASSWORD=replace_with_strong_database_password
REDIS_PASSWORD=replace_with_strong_redis_password
NACOS_AUTH_TOKEN=replace_with_base64_token
FRONTEND_URL=http://127.0.0.1

# AI 客服（service-ai）。密钥只放在本地 .env，绝不提交（.gitignore 已忽略 .env）。
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 置为 false 可让 AI 相关装配不生效，服务仍能启动，便于隔离排查
MALL_AI_ENABLED=true
