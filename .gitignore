# Java and Maven
**/target/
*.class
*.jar
*.war
*.ear

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Node
**/node_modules/
**/dist/
**/.vite/

# Local configuration and secrets
.env
.env.*
!.env.example
**/application-local.yml
**/application-local.yaml
**/application-secret.yml
**/application-secret.yaml

# Local database exports and backups
deploy/mysql/db_spzx.sql
deploy/mysql/db_spzx-import-selection-mall.sql
deploy/mysql/selection_mall-backup-before-db-spzx-import.sql

# Logs and runtime output
**/logs/
*.log
*.pid

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.swp
# Some editors write via a sibling temp dir ("<file>.<pid>.<uuid>.tmpdir/").
# Besides being noise, such a dir can crash Vite's file watcher with EBUSY
# while it is being written, so keep it out of the tree entirely.
.*.tmpdir/
